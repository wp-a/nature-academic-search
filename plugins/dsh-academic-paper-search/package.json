{
  "name": "dsh-academic-paper-search",
  "version": "0.1.0",
  "description": "Academic Paper Search bridge for DeepSeek Harness: verified multi-source literature search over the existing MCP server.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "academic-search",
    "paper-search",
    "literature",
    "mcp",
    "citation-graph",
    "pubmed",
    "arxiv",
    "openalex",
    "crossref"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": {
    "name": "wp-a",
    "url": "https://github.com/wp-a"
  },
  "homepage": "https://github.com/wp-a/nature-academic-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/wp-a/nature-academic-search.git",
    "directory": "plugins/dsh-academic-paper-search"
  },
  "bugs": {
    "url": "https://github.com/wp-a/nature-academic-search/issues"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
